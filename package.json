{
  "name": "fakefoundy",
  "displayName": "FakeFoundy",
  "description": "TrueForge-native coding agent proof of integration",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=22.14.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:fakefoundy.start",
    "onCommand:fakefoundy.inline"
  ],
  "contributes": {
    "commands": [
      {
        "command": "fakefoundy.start",
        "title": "FakeFoundy: Start TrueForge Agent"
      },
      {
        "command": "fakefoundy.review",
        "title": "FakeFoundy: Review Proposed Edit"
      },
      {
        "command": "fakefoundy.cancel",
        "title": "FakeFoundy: Cancel Run"
      },
      {
        "command": "fakefoundy.inline",
        "title": "FakeFoundy: Edit Selection"
      },
      {
        "command": "fakefoundy.panel",
        "title": "FakeFoundy: Open Agent Panel"
      }
    ],
    "configuration": {
      "title": "FakeFoundy",
      "properties": {
        "fakefoundy.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8790"
        },
        "fakefoundy.model": {
          "type": "string",
          "default": "openai/gpt-4.1-mini"
        },
        "fakefoundy.mcpPort": {
          "type": "number",
          "default": 31337
        },
        "fakefoundy.fallbackModel": {
          "type": "string",
          "default": "",
          "description": "Optional second TrueForge model to try once after an unsuccessful primary run. Failed-attempt proposals are discarded."
        },
        "fakefoundy.runTimeoutSeconds": {
          "type": "number",
          "default": 300,
          "minimum": 10,
          "maximum": 1800,
          "description": "Maximum run duration, including fallback, before cancellation."
        },
        "fakefoundy.contextBudgetBytes": {
          "type": "number",
          "default": 16000,
          "minimum": 256,
          "maximum": 65536,
          "description": "Maximum UTF-8 bytes of retrieved context excerpts per turn. Prompt and tool results are additional."
        }
      }
    },
    "keybindings": [
      {
        "command": "fakefoundy.inline",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i",
        "when": "editorTextFocus && editorHasSelection && !editorReadonly"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test dist/test/*.test.js",
    "trueforge": "trueforge",
    "smoke": "npm run build && node scripts/smoke.mjs"
  },
  "dependencies": {
    "@truefoundry/trueforge-sdk": "0.185.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.19.1",
    "@types/vscode": "1.96.0",
    "@truefoundry/trueforge": "0.185.1"
  },
  "license": "MIT"
}
