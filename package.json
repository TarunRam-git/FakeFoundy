{
  "name": "patchlight",
  "displayName": "PatchLight",
  "description": "Review and apply AI-proposed edits in VS Code with a local TrueForge agent",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=22.14.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:patchlight.start",
    "onCommand:patchlight.inline"
  ],
  "contributes": {
    "commands": [
      {
        "command": "patchlight.start",
        "title": "PatchLight: Start TrueForge Agent"
      },
      {
        "command": "patchlight.review",
        "title": "PatchLight: Review Proposed Edit"
      },
      {
        "command": "patchlight.cancel",
        "title": "PatchLight: Cancel Run"
      },
      {
        "command": "patchlight.inline",
        "title": "PatchLight: Edit Selection"
      },
      {
        "command": "patchlight.panel",
        "title": "PatchLight: Open Agent Panel"
      }
    ],
    "configuration": {
      "title": "PatchLight",
      "properties": {
        "patchlight.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8790"
        },
        "patchlight.model": {
          "type": "string",
          "default": "openai/gpt-4.1-mini"
        },
        "patchlight.mcpPort": {
          "type": "number",
          "default": 31337
        },
        "patchlight.fallbackModel": {
          "type": "string",
          "default": "",
          "description": "Optional second TrueForge model to try once after an unsuccessful primary run. Failed-attempt proposals are discarded."
        },
        "patchlight.runTimeoutSeconds": {
          "type": "number",
          "default": 300,
          "minimum": 10,
          "maximum": 1800,
          "description": "Maximum run duration, including fallback, before cancellation."
        },
        "patchlight.contextBudgetBytes": {
          "type": "number",
          "default": 16000,
          "minimum": 256,
          "maximum": 131072,
          "description": "Maximum UTF-8 bytes of retrieved context excerpts per turn. Prompt and tool results are additional."
        }
      }
    },
    "keybindings": [
      {
        "command": "patchlight.inline",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i",
        "when": "editorTextFocus && editorHasSelection && !editorReadonly"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test dist/test/*.test.js scripts/test/*.test.mjs",
    "trueforge": "node scripts/trueforge.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@truefoundry/trueforge-sdk": "0.185.0",
    "diff": "9.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@truefoundry/trueforge": "0.185.1",
    "@types/node": "22.19.1",
    "@types/vscode": "1.96.0",
    "typescript": "5.9.3"
  },
  "license": "MIT"
}
